{
  "name": "electron-cdp-utils",
  "version": "0.4.8",
  "author": "ntoskrnl7@gmail.com",
  "license": "ISC",
  "main": "index.js",
  "scripts": {
    "build": "tsc && tsc -p ./tsconfig.esm.json && esbuild src/superJSON.browser.ts --bundle --outfile=esm/SuperJSON.browser.js --platform=browser --format=iife --global-name=SuperJSON --minify && node replace-raw-imports.mjs",
    "lint": "concurrently npm:lint:es npm:lint:ox",
    "lint:es": "eslint src/*.ts",
    "lint:ox": "oxlint src",
    "test": "npm run build && npm run test:mock && npm run test:e2e",
    "test:mock": "node --test test/mock/*.test.cjs",
    "test:e2e": "node --test test/e2e/*.test.cjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "devtools-protocol": "^0.0.1629771",
    "events": "^3.3.0",
    "superjson": "2.2.6"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "oxlint": "^1.64.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "sideEffects": [
    "SuperJSON.browser.js"
  ],
  "files": [
    "esm/**.*",
    "*.js",
    "*.d.ts",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "require": "./index.js",
      "import": "./esm/index.js"
    },
    "./*": {
      "require": "./*.js",
      "import": "./esm/*.js"
    }
  }
}
